SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# 2. 門市舊 ERP SQL Server 連線設定 (通常維持預設即可自動探測)
SQL_SERVER=.\SQLEXPRESS
SQL_DB=ShengLong_Inspection
