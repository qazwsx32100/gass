# Public browser connection string from Sentry project settings.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_SENTRY_RELEASE=

# Private server and source-map settings. Never commit real values.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Temporary emergency admin recovery only. Remove immediately after one
# successful recovery login has replaced the stored password hash.
ADMIN_DEFAULT_PASSWORD=

# Telegram Multi-Group & Bot Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDER_CHAT_ID=
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_REPORT_CHAT_ID=
ADMIN_CHAT_ID=

# GitHub Actions 遠端觸發 (用於 /api/trigger-github-workflow 端點)
# PAT 需要 actions:write 權限，前往 GitHub > Settings > Developer settings > Personal access tokens 建立
GITHUB_ACTIONS_PAT=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
# 預設觸發分支，通常是 main
GITHUB_WORKFLOW_REF=main
