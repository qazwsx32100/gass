{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shenglong.vercel.app/schemas/multi-agent-task.v1.schema.json",
  "title": "ShengLong Multi-Agent Collaborative Dev Task Protocol v1.0.0",
  "description": "Standardized JSON task contract emitted by the Multi-Agent Collaboration Hub and enforced by the Execution Bridge Policy Gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "idempotencyKey",
    "createdAt",
    "initiator",
    "riskLevel",
    "requiresBossApproval",
    "target",
    "objective",
    "impactAnalysis",
    "planSteps",
    "acceptanceCriteria",
    "safetyConstraints",
    "consensus"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "taskId": {
      "type": "string",
      "pattern": "^TASK-[0-9]{8}-[0-9A-Za-z_-]{3,24}$"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 12,
      "maxLength": 128
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "dryRun": {
      "type": "boolean"
    },
    "initiator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "requestedBy", "participatingModels"],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["multi_agent_hub", "eight_ai_departments", "boss_console", "github_issue"]
        },
        "requestedBy": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "participatingModels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64
          }
        }
      }
    },
    "riskLevel": {
      "type": "string",
      "enum": ["L1", "L2", "L3"]
    },
    "requiresBossApproval": {
      "type": "boolean"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "baseBranch", "featureBranch", "allowedPaths"],
      "properties": {
        "repository": {
          "type": "string",
          "enum": [
            "qazwsx32100/gass",
            "qazwsx32100/shenglong-next",
            "qazwsx32100/shenglong-line-liff"
          ]
        },
        "baseBranch": {
          "type": "string",
          "const": "main"
        },
        "featureBranch": {
          "type": "string",
          "pattern": "^ai-agent/[a-z0-9][a-z0-9._/-]{2,64}$"
        },
        "allowedPaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "forbiddenPaths": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 4,
          "maxLength": 160
        },
        "summary": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000
        },
        "issueNumber": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "impactAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "affectedSystems",
        "touchesLegacyErp",
        "touchesDriverLocation",
        "touchesPricingMaster",
        "mitigationNotes"
      ],
      "properties": {
        "affectedSystems": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64
          }
        },
        "touchesLegacyErp": {
          "type": "boolean"
        },
        "touchesDriverLocation": {
          "type": "boolean"
        },
        "touchesPricingMaster": {
          "type": "boolean"
        },
        "mitigationNotes": {
          "type": "string",
          "minLength": 8,
          "maxLength": 1000
        }
      }
    },
    "planSteps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "action", "description"],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1
          },
          "action": {
            "type": "string",
            "enum": ["inspect", "add_test", "edit_code", "update_docs", "verify", "open_pr"]
          },
          "description": {
            "type": "string",
            "minLength": 4,
            "maxLength": 500
          }
        }
      }
    },
    "acceptanceCriteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredCommands",
        "maxChangedFiles",
        "mustOpenPullRequest",
        "allowDirectMainPush"
      ],
      "properties": {
        "requiredCommands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          }
        },
        "maxChangedFiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "mustOpenPullRequest": {
          "type": "boolean",
          "const": true
        },
        "allowDirectMainPush": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "safetyConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "noLegacyErpDdl",
        "noDriverGpsPolling",
        "minPollingIntervalSeconds",
        "noHardcodedSecrets",
        "maxAgentIterations",
        "maxTokenBudgetUsd"
      ],
      "properties": {
        "noLegacyErpDdl": {
          "type": "boolean",
          "const": true
        },
        "noDriverGpsPolling": {
          "type": "boolean",
          "const": true
        },
        "minPollingIntervalSeconds": {
          "type": "integer",
          "minimum": 60
        },
        "noHardcodedSecrets": {
          "type": "boolean",
          "const": true
        },
        "maxAgentIterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "maxTokenBudgetUsd": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 10
        }
      }
    },
    "consensus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "dissentingNotes", "confidenceScore"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["approved", "escalate_to_boss", "rejected"]
        },
        "dissentingNotes": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "confidenceScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
